# --- Required ---

# Admin Plex token. Whoever owns this token becomes the admin account.
# Finding it: https://support.plex.tv/articles/204059436
PLEX_TOKEN=

# Your Plex server, as reachable FROM THIS CONTAINER. "localhost" points at
# the container itself, so use the host's LAN IP or a docker network hostname.
PLEX_SERVER_URL=http://192.168.1.10:32400

# Sonarr and Radarr. API keys are under Settings > General in each.
SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=

# Encrypts the Plex tokens stored on disk. Required — the app refuses to
# start without it. Generate one: openssl rand -hex 32
SESSION_SECRET=

# --- Optional ---

# Discord webhook for "notify admin" messages when a fix gets stuck.
# Leave blank to disable (the notify button will report it's unavailable).
DISCORD_WEBHOOK_URL=

# Tautulli, used for some watch statistics. Blank is fine; stats fall back
# to Plex's own history.
TAUTULLI_URL=
TAUTULLI_API_KEY=

# Where the "Request" links for missing movies/shows point (Overseerr,
# Jellyseerr, Ombi...). Blank hides the request links.
REQUEST_URL=

# Library names to hide from recently-watched and stats, comma-separated.
HIDDEN_LIBRARIES=

# Set true if you serve the app over HTTPS (e.g. behind a reverse proxy) so
# session cookies are marked Secure. Leave blank for plain-HTTP LAN use.
SECURE_COOKIE=

# Host port the app is published on (container listens on 8000 internally).
PORT=3080

# --- Push notifications (optional, needs a companion iOS app) ---
# Leave blank and push is simply off. Create an APNs key in the Apple
# developer portal under Certificates, Identifiers & Profiles > Keys, with
# APNs ticked. The .p8 downloads exactly once. Drop it under data/apns/ —
# that directory is bind-mounted into the container and gitignored.
APNS_KEY_PATH=/app/data/apns/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
# Must match the bundle identifier of your iOS build.
APNS_BUNDLE_ID=
# true while testing with a development build; false/blank for TestFlight
# and App Store builds.
APNS_USE_SANDBOX=
