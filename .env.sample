# Copy this to .env and fill it in.
#
# Everything under REQUIRED must be set. Everything below it can be left
# blank — the feature it belongs to simply stays off, and nothing else
# changes.
#
# Lines marked SECRET are credentials. .env is gitignored and should stay
# that way; never paste one of these into an issue or a screenshot.


# ============================================================
# REQUIRED
# ============================================================

# SECRET. Admin Plex token. Whoever owns this token becomes the admin
# account. Finding it: https://support.plex.tv/articles/204059436
PLEX_TOKEN=

# Your Plex server, as reachable FROM THIS CONTAINER. "localhost" points at
# the container itself, so use the host's LAN IP or a docker network hostname.
PLEX_SERVER_URL=http://192.168.1.10:32400

# Sonarr. The API key is under Settings > General.
SONARR_URL=http://192.168.1.10:8989
# SECRET.
SONARR_API_KEY=

# Radarr. Same place for the key.
RADARR_URL=http://192.168.1.10:7878
# SECRET.
RADARR_API_KEY=

# SECRET. Encrypts the Plex tokens stored on disk. The app refuses to start
# without it. Generate one: openssl rand -hex 32
SESSION_SECRET=


# ============================================================
# OPTIONAL — blank means the feature is off
# ============================================================

# SECRET. Discord webhook for "notify admin" messages when a fix gets stuck.
# Blank disables it (the notify button reports it's unavailable).
DISCORD_WEBHOOK_URL=

# Tautulli, used for some watch statistics. Blank is fine; stats fall back
# to Plex's own history.
TAUTULLI_URL=
# SECRET.
TAUTULLI_API_KEY=

# Where the "Request" links for missing movies/shows point (Overseerr,
# Jellyseerr, Ombi...). Blank hides the request links.
REQUEST_URL=

# Library names to hide from recently-watched and stats, comma-separated.
HIDDEN_LIBRARIES=

# Set true if you serve the app over HTTPS (e.g. behind a reverse proxy) so
# session cookies are marked Secure. Leave blank for plain-HTTP LAN use.
SECURE_COOKIE=

# Host port the app is published on (container listens on 8000 internally).
PORT=3080


# ============================================================
# OPTIONAL — push notifications (needs YOUR OWN iOS app)
# ============================================================
#
# These cannot push to Resplice on the App Store. An APNs key only reaches
# bundle identifiers owned by the Apple developer team that made it, so only
# that app's publisher can push to it. You need your own iOS client, your own
# bundle id and your own paid Apple developer account. See the README.
#
# If that isn't you, leave this whole block blank. Push stays off, the health
# endpoint reports push: false, and clients know not to ask for permission.
#
# Create the key in the Apple developer portal under Certificates,
# Identifiers & Profiles > Keys, with APNs ticked. The .p8 downloads exactly
# once. Drop it under data/apns/ — bind-mounted into the container, and
# gitignored.

# SECRET (the .p8 file itself — anyone holding it can push to your apps).
APNS_KEY_PATH=/app/data/apns/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
# The bundle identifier of your own iOS build.
APNS_BUNDLE_ID=
# true while testing with a development build; false/blank for TestFlight
# and App Store builds.
APNS_USE_SANDBOX=
